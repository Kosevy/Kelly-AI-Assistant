# Kelly - Environment Variables Template
# Copy this file to .env and adjust the values for your setup.
# All environment variables use the prefix: KELLY_

# ─── STT (Speech-to-Text via faster-whisper) ───────────────────────────────
# KELLY_STT_MODEL=small
# KELLY_STT_DEVICE=cpu
# KELLY_STT_COMPUTE_TYPE=int8
# KELLY_STT_LANGUAGE=es
# KELLY_STT_VAD_FILTER=true
# KELLY_STT_VAD_MIN_SILENCE_MS=500

# ─── LLM (llama.cpp server) ─────────────────────────────────────────────────
# KELLY_LLM_SERVER_URL=http://127.0.0.1:8085/completion
# KELLY_LLM_TEMPERATURE=0.4           # Lower = more deterministic, fewer hallucinations
# KELLY_LLM_MAX_TOKENS=120
# KELLY_LLM_TOP_P=0.9
# KELLY_LLM_REPEAT_PENALTY=1.1
# KELLY_LLM_SYSTEM_PROMPT_PATH=prompts/system.txt

# ─── TTS (Coqui XTTS-v2 Zero-Shot Voice Cloning) ────────────────────────────
# KELLY_TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# KELLY_TTS_DEVICE=cuda
# KELLY_TTS_SAMPLE_RATE=24000
# KELLY_TTS_MIN_CHUNK_CHARS=30        # Minimum buffer characters before synthesizing chunk
# KELLY_TTS_MIN_FINAL_CHARS=5
# KELLY_VOICE_SAMPLE_PATH=voice_sample.wav

# ─── Server & Networking ───────────────────────────────────────────────────
# KELLY_HOST=0.0.0.0
# KELLY_PORT=8000
# KELLY_LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR

# ─── Storage Paths ─────────────────────────────────────────────────────────
# KELLY_PROMPTS_DIR=prompts
# KELLY_LOGS_DIR=logs

# ─── Conversation History ──────────────────────────────────────────────────
# KELLY_HISTORY_MAX_TURNS=6           # Maximum turns kept in memory (1 turn = user + assistant)
# KELLY_HISTORY_MAX_TOKENS_ESTIMATE=2048

# ─── STT Diagnostic Audio ──────────────────────────────────────────────────
# KELLY_DEBUG_SAVE_AUDIO=false        # If true, saves raw STT audio to debug/stt_{timestamp}.raw
# KELLY_DEBUG_AUDIO_DIR=debug
# KELLY_DEBUG_AUDIO_MAX_FILES=20
